# ════════════════════════════════════════════════════════
# .env.easepanel — Variáveis para deploy EasePanel Self-Host
# Copie este arquivo para .env na VPS e preencha os valores
# NUNCA commite o .env com valores reais
# ════════════════════════════════════════════════════════

# ─────────────────────────────────────────
# BANCO DE DADOS
# ─────────────────────────────────────────
POSTGRES_PASSWORD=mude-para-uma-senha-forte-aqui

# ─────────────────────────────────────────
# JWT / SEGURANÇA
# ─────────────────────────────────────────
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# ─────────────────────────────────────────
# URLS PÚBLICAS
# ─────────────────────────────────────────
SITE_URL=https://bingo.teusite.top
API_EXTERNAL_URL=https://supabase.teusite.top
ADDITIONAL_REDIRECT_URLS=

# ─────────────────────────────────────────
# VITE — Build args (baked no JS em build time)
# ─────────────────────────────────────────
VITE_SUPABASE_URL=https://supabase.teusite.top
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_LIVE_SERVER_URL=https://bingo.teusite.top

# ─────────────────────────────────────────
# EMAIL SMTP — teusite.top hosting
# Host: mail.teusite.top | Porta: 465 (SSL/TLS)
# ─────────────────────────────────────────
SMTP_HOST=mail.teusite.top
SMTP_PORT=465
SMTP_USER=bingoshow@teusite.top
# Preencha com a senha da conta bingoshow@teusite.top
SMTP_PASS=PREENCHA_COM_SENHA_DO_EMAIL
SMTP_ADMIN_EMAIL=bingoshow@teusite.top
SMTP_SENDER_NAME=Bingo Show
ENABLE_EMAIL_AUTOCONFIRM=false
DISABLE_SIGNUP=false

# ─────────────────────────────────────────
# ADMIN INICIAL
# ─────────────────────────────────────────
LOCAL_ADMIN_EMAIL=bingoshow@teusite.top
LOCAL_ADMIN_PASSWORD=PREENCHA_COM_SENHA_FORTE
LOCAL_ADMIN_NAME=Administrador
