# ════════════════════════════════════════════════════════
# .env.easepanel — Variáveis para deploy EasePanel Self-Host
# Copie este arquivo para .env na VPS e preencha os valores
# NUNCA commite o .env com valores reais
# ════════════════════════════════════════════════════════

# ─────────────────────────────────────────
# BANCO DE DADOS
# ─────────────────────────────────────────
# Senha forte para o PostgreSQL (mude obrigatoriamente)
POSTGRES_PASSWORD=mude-para-uma-senha-forte-aqui

# ─────────────────────────────────────────
# JWT / SEGURANÇA
# ─────────────────────────────────────────
# Secret JWT — mínimo 32 caracteres, string aleatória forte
# Gere com: openssl rand -base64 32
JWT_SECRET=seu-jwt-secret-aleatorio-minimo-32-caracteres

# ANON_KEY — JWT público (role: anon), gerado com JWT_SECRET acima
# Gere em: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.COLOQUE_SEU_ANON_KEY_AQUI

# SERVICE_ROLE_KEY — JWT privado (role: service_role), NUNCA exponha no frontend
# Gere junto com o ANON_KEY
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.COLOQUE_SEU_SERVICE_ROLE_KEY_AQUI

# ─────────────────────────────────────────
# URLS PÚBLICAS (substitua pelo seu domínio)
# ─────────────────────────────────────────
# URL pública do app bingo (EasePanel configura isso)
SITE_URL=https://bingo.seudominio.com

# URL pública da API Supabase (Kong gateway)
# EasePanel roteia este domínio para a porta 8000 do kong
API_EXTERNAL_URL=https://supabase.seudominio.com

# URLs adicionais permitidas em redirects de auth (separadas por vírgula)
ADDITIONAL_REDIRECT_URLS=

# ─────────────────────────────────────────
# VITE — Build args (baked no JS pelo Vite)
# ─────────────────────────────────────────
# URL pública do Supabase Kong — mesma que API_EXTERNAL_URL
VITE_SUPABASE_URL=https://supabase.seudominio.com

# Mesma que ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.COLOQUE_SEU_ANON_KEY_AQUI

# URL do servidor WebRTC (Socket.IO para live streaming)
# Mesma URL do app ou subdominio dedicado
VITE_LIVE_SERVER_URL=https://bingo.seudominio.com

# ─────────────────────────────────────────
# EMAIL (SMTP) — necessário para auth emails
# ─────────────────────────────────────────
# Servidor SMTP para envio de confirmação/recuperação de senha
# Opções gratuitas: Resend (3000/mês), Brevo (300/dia), Mailgun
SMTP_HOST=smtp.seuservidor.com
SMTP_PORT=587
SMTP_USER=seu-usuario-smtp
SMTP_PASS=sua-senha-smtp
SMTP_ADMIN_EMAIL=admin@seudominio.com
SMTP_SENDER_NAME=Bingo Show

# Se true, usuários confirmam email automaticamente (só para testes)
ENABLE_EMAIL_AUTOCONFIRM=false

# Se true, desabilita novos cadastros (útil após setup inicial)
DISABLE_SIGNUP=false

# ─────────────────────────────────────────
# ADMIN INICIAL
# ─────────────────────────────────────────
# Credenciais do admin criado automaticamente no bootstrap
LOCAL_ADMIN_EMAIL=admin@seudominio.com
LOCAL_ADMIN_PASSWORD=SenhaAdmin123!
LOCAL_ADMIN_NAME=Administrador
