{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server.js",
    "server": "node server.js",
    "dev-s": "npm run dev:full",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "dev:live": "npm run dev:full",
    "bootstrap:new": "node scripts/bootstrap-new-machine.mjs",
    "s-start": "supabase start && node scripts/write-local-env.mjs && node scripts/bootstrap-local-admin.mjs",
    "s-stop": "supabase stop",
    "s-status": "supabase status",
    "s-db": "supabase db",
    "s-pull": "supabase db pull",
    "s-push": "supabase db push",
    "s-reset": "supabase db reset",
    "s-login": "supabase login",
    "s-logout": "supabase logout",
    "s-profile": "supabase profile",
    "s-user": "supabase user",
    "s-list": "supabase projects list",
    "s-projeto": "supabase link --project-ref",
    "s-projeto-stop": "supabase unlink",
    "local:env": "node scripts/write-local-env.mjs",
    "local:env:lan": "set LOCAL_SUPABASE_PUBLIC_URL=http://192.168.1.218:54321&& node scripts/write-local-env.mjs",
    "vps:env": "node scripts/write-vps-local-env.mjs",
    "local:admin": "node scripts/bootstrap-local-admin.mjs",
    "s-local-up": "npm run s-start && npm run dev:full",
    "lan:https:env": "set VPS_SUPABASE_PUBLIC_URL=https://supabase.lan&& set VPS_LIVE_SERVER_URL=https://bingo.lan&& npm run vps:env",
    "lan:https:up": "npm run s-start && npm run lan:https:env && npm run docker:up",
    "lan:mobile:env": "set LAN_APP_HOST=bingo.up&& set VPS_SUPABASE_PUBLIC_URL=http://bingo.up/supabase&& set LAN_PROTOCOL=http&& set LAN_ENABLE_LIVE=0&& npm run vps:env",
    "lan:mobile:up": "node scripts/lan-mobile-up.mjs",
    "lan:mobile:down": "node scripts/lan-mobile-down.mjs",
    "docker:up:mobile": "node scripts/lan-mobile-up.mjs",
    "docker:down:mobile": "node scripts/lan-mobile-down.mjs",
    "lan:https:down": "npm run docker:down && npm run s-stop",
    "vps:selfhost:up": "supabase start && npm run vps:env && npm run local:admin && npm run docker:up",
    "vps:selfhost:down": "npm run docker:down && supabase stop",
    "docker:build": "docker build -t bingo-buddy:latest .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
